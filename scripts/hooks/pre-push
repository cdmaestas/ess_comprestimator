#!/usr/bin/env bash
# Pre-push hook: run full test suite before pushing
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "[pre-push] Running backend test suite..."

VENV="$ROOT/.venv"
if [[ ! -f "$VENV/bin/activate" ]]; then
  echo "  No .venv found — skipping Python tests (run ./dev.sh once to create it)"
  exit 0
fi

# Call the venv's interpreter directly rather than `source activate && python`:
# activation only prepends $VENV/bin to PATH, which does not reliably resolve a
# bare `python` across shells and worktrees (a broken lookup fails the hook even
# when the tests pass). An absolute path is deterministic.
if ! MOCK_BINARY=true "$VENV/bin/python" -m pytest tests/ -q --tb=short; then
  echo ""
  echo "Pre-push: tests failed. Fix failing tests before pushing."
  exit 1
fi

echo "[pre-push] All tests passed."
