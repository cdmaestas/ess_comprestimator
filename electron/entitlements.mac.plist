<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required by Electron for JIT compilation -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Required for the embedded Python runtime -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- The PyInstaller onefile backend unpacks its .so files to a temp dir at
       launch and dlopen()s them. Those extracted files carry no signature, so
       under the hardened runtime library validation would refuse to load them
       and the app would die on first launch — only after notarization, since
       unsigned local builds never enforce this. Both keys are part of
       electron-builder's own default mac entitlements. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <!-- Network access — backend binds a loopback port; frontend talks to it -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
  <!-- File access — users pick directories to analyse -->
  <key>com.apple.security.files.user-selected.read-only</key>
  <true/>
</dict>
</plist>
