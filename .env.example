# ── ESS Comprestimator — environment variables ──────────────────────────────
#
# Copy this file to .env and adjust values for your environment.
# The backend reads these at startup; the frontend uses vite.config.ts proxying.

# Absolute path to the compiled C binary.
# Default: <repo_root>/comprestimator   (works if you run `uvicorn` from the repo root)
# COMPRESTIMATOR_PATH=/app/comprestimator

# Base directory for per-job temp directories.
# Default: $TMPDIR/comprestimator_jobs
# RESULTS_BASE_DIR=/tmp/comprestimator_jobs

# Maximum number of jobs that may run concurrently.
# Default: 3
# MAX_CONCURRENT_JOBS=3

# Set to "true" to return synthetic results without invoking the binary.
# Useful for frontend development on macOS where the Linux binary is unavailable.
# Default: false
# MOCK_BINARY=true
